# Server-only values. Configure using the Vercel secret/environment UI, never in chat.
# Existing separate WEBSITE Supabase project. Never use the Polpo Padel project.
POLPO_LEADS_SUPABASE_URL=
POLPO_LEADS_SUPABASE_PROJECT_REF=
POLPO_LEADS_SUPABASE_SERVICE_ROLE_KEY=
POLPO_LEADS_SITE_PROJECT_CONFIRMED=false
POLPO_PADEL_PROJECT_REF=
POLPO_CONSULTATION_HMAC_KEY=
POLPO_LEADS_RETENTION_DAYS=
POLPO_HUBSPOT_ACCESS_TOKEN=
# Required at launch after controller review; use an exact supported hs_legal_basis value.
POLPO_HUBSPOT_CONTACT_LEGAL_BASIS=
POLPO_HUBSPOT_PORTAL_ID=
POLPO_HUBSPOT_COMPANY_DOMAIN_ALLOWLIST=
POLPO_RESEND_API_KEY=
POLPO_RESEND_FROM=
POLPO_CONSULTATION_WORKER_SECRET=
POLPO_CONSULTATION_ALLOWED_ORIGINS=https://polpo-ai.com
# All verification flags are attestations AFTER documented checks, never placeholders.
POLPO_HUBSPOT_SCHEMA_VERIFIED=false
POLPO_HUBSPOT_AUTOMATIONS_REVIEWED=false
POLPO_CONSULTATION_SCHEDULER_VERIFIED=false
POLPO_CONSULTATION_MONITORING_VERIFIED=false
POLPO_CONSULTATION_NOTIFICATION_VERIFIED=false
POLPO_CONSULTATION_E2E_VERIFIED=false
POLPO_CONSULTATION_RELEASE_APPROVED=false
POLPO_PLATFORM_SECURITY_REVIEWED=false
POLPO_PRIVACY_VERIFIED_VERSION=
POLPO_CONSULTATION_DELIVERY_ENABLED=false
POLPO_CONSULTATION_ENABLED=false
POLPO_CONSULTATION_ANALYTICS_ENABLED=false

# Optional existing project credential fallback: RESEND_API_KEY, server-only.
# CRON_SECRET must match POLPO_CONSULTATION_WORKER_SECRET if configured.
# Current Hobby setup uses Supabase pg_cron; delivery switch stays OFF until E2E.

# Operator setup only. Default OFF; a future expiry no more than 2 hours away is required.
POLPO_CONSULTATION_SETUP_ENABLED=false
POLPO_SCHEMA_APPLY_APPROVED=false
POLPO_CONSULTATION_SETUP_EXPIRES_AT=

# Temporary authenticated synthetic verification; automatically expires within 24h.
POLPO_CONSULTATION_TEST_ENABLED=false
POLPO_CONSULTATION_TEST_SECRET=
POLPO_CONSULTATION_TEST_EXPIRES_AT=
